# Supabase project (Settings → API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The "anon" / "publishable" key (sb_publishable_... on newer projects, or a
# JWT on older ones — both work). Safe for the browser; still governed by
# the RLS policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The "service_role" / "secret" key (sb_secret_... on newer projects, or a
# JWT on older ones). Server-only — never expose this to the browser. Used
# for all reads/writes and to persist the Baileys WhatsApp session (bypasses
# RLS entirely).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# The passcode that turns `/?admin=SECRET` into the banker view. Pick
# something long and random — it sets an httpOnly cookie and is never shown
# again after that first visit.
ADMIN_SECRET=change-me

# The banker's own WhatsApp number (digits only, country code first, e.g.
# 919812345678) — used to request a pairing code from the connection sheet.
ADMIN_WHATSAPP_NUMBER=919800000000

# WhatsApp group JID the Bad Cop posts to, e.g. 120363012345678901@g.us.
# Looked up once the bot is connected (log sock.ev events, or fetch
# sock.groupFetchAllParticipating() during setup) and can also be set later
# from the banker's Trip setup sheet.
WHATSAPP_GROUP_JID=

# Optional — lets a Railway cron job trigger POST /api/bad-cop without a
# browser session, via an `X-Cron-Secret` header.
CRON_SECRET=

# Set to "1" to boot the Next.js app without starting the Baileys socket
# (useful for local UI work without a WhatsApp session).
DISABLE_WHATSAPP_BOT=0

PORT=3000
